#!/bin/sh
### BEGIN INIT INFO
# Provides:          php7.4-fpm
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PHP 7.4 FastCGI Process Manager
### END INIT INFO
set -e
daemon=/usr/sbin/php-fpm7.4
pidfile=/run/php/php7.4-fpm.pid
case "$1" in
  start)
    install -d -m 0755 /run/php
    "$daemon" --test
    start-stop-daemon --start --quiet --pidfile "$pidfile" --exec "$daemon" -- --daemonize
    ;;
  stop)
    start-stop-daemon --stop --quiet --oknodo --retry QUIT/30/KILL/5 --pidfile "$pidfile" --exec "$daemon"
    ;;
  restart) "$0" stop; "$0" start ;;
  try-restart|force-reload)
    if "$0" status >/dev/null 2>&1; then "$0" restart; fi
    ;;
  reload)
    "$daemon" --test
    start-stop-daemon --stop --signal USR2 --quiet --pidfile "$pidfile" --exec "$daemon"
    ;;
  status)
    . /lib/lsb/init-functions
    status_of_proc -p "$pidfile" "$daemon" php7.4-fpm
    ;;
  *) echo "Usage: $0 {start|stop|restart|reload|status}" >&2; exit 2 ;;
esac
